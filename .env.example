# Copy to .env and fill in. .env is git-ignored.
# ChatKHU API Gateway (OpenAI-compatible). Base URL must end at the version prefix, e.g. https://<gateway>/v1
# Leave empty to run without LLM: only the 요약 button is disabled, everything else works.
LLM_BASE_URL=
LLM_API_KEY=
# Lightweight model verified on the ChatKHU gateway; change if your gateway lists a cheaper one.
LLM_MODEL=gpt-5.4-nano

# Optional: raises rate limits. Without them the app still works (with backoff / a small daily OpenAlex budget).
S2_API_KEY=
OPENALEX_API_KEY=
